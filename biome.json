{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"noNestedComponentDefinitions": "warn"
			}
		}
	},
	"formatter": { "enabled": true },
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/src/**/*.tsx",
			"packages/*/*.ts",
			"packages/*/package.json"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	}
}

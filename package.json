{
	"name": "tap",
	"version": "0.1.0",
	"description": "TAP (Time Allocation Protocol) - A federated booking protocol for real-time availability and bookings across untrusted parties",
	"private": true,
	"packageManager": "bun@1.2.18",
	"workspaces": [
		"packages/*"
	],
	"keywords": [
		"scheduling",
		"booking",
		"protocol",
		"federated",
		"real-time",
		"availability",
		"time-allocation",
		"distributed-systems"
	],
	"homepage": "https://github.com/open-tap/tap",
	"bugs": {
		"url": "https://github.com/open-tap/tap/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/open-tap/tap.git"
	},
	"author": "simonorzel26",
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"build:packages": "turbo run build --filter=@open-tap/protocol --filter=@open-tap/core --filter=@open-tap/client",
		"dev": "bun run scripts/dev.ts",
		"dev:api": "cd packages/api && bun run dev",
		"dev:app": "cd packages/app && bun run dev --turbopack",
		"clean": "turbo run clean",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch",
		"test:coverage": "turbo run test:coverage",
		"db:generate": "cd packages/db && bun run migrate:generate",
		"db:migrate": "cd packages/db && bun run migrate",
		"db:reset": "cd packages/db && bun run reset",
		"check": "biome check --write .",
		"changeset": "changeset",
		"changeset:auto": "bun run scripts/create-changesets.ts",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@changesets/cli": "^2.29.8",
		"baseline-browser-mapping": "^2.9.5",
		"turbo": "latest",
		"typescript": "latest"
	},
	"dependencies": {
		"ulid": "^3.0.1"
	}
}

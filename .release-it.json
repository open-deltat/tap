{
	"$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
	"git": {
		"commitMessage": "chore: release v${version}",
		"tagName": "v${version}",
		"push": true
	},
	"github": {
		"release": true
	},
	"npm": {
		"publish": false
	},
	"hooks": {
		"before:init": ["bun run build", "bun run test"],
		"after:bump": "echo Version bumped to ${version}"
	}
}


{
	"name": "@tap/ws-client",
	"version": "0.1.0",
	"description": "TAP v0.1 WebSocket Client - Framework-agnostic client for TAP availability and bookings",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@tap/core": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}

{
	"name": "@tap/protocol",
	"version": "0.1.0",
	"description": "TAP - Time Allocation Protocol schemas, types, and constants",
	"keywords": [
		"tap",
		"time-allocation",
		"booking",
		"scheduling",
		"protocol",
		"zod",
		"typescript"
	],
	"homepage": "https://github.com/simonorzel26/tap",
	"bugs": {
		"url": "https://github.com/simonorzel26/tap/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simonorzel26/tap.git",
		"directory": "packages/protocol"
	},
	"license": "MIT",
	"author": "simonorzel26",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./openapi": {
			"types": "./dist/openapi.d.ts",
			"import": "./dist/openapi.js",
			"default": "./dist/openapi.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun build ./src/index.ts ./src/openapi.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"dev": "tsc -p tsconfig.build.json --watch",
		"prepublishOnly": "bun run clean && bun run build && bun run test",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^7.3.0"
	},
	"peerDependencies": {
		"zod": "^3.22.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": false
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.0.0",
		"zod": "^3.23.8"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}

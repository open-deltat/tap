{
	"name": "@tap/protocol",
	"version": "0.1.0",
	"description": "TAP - Time Allocation Protocol Specifications (TypeScript)",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.0.0"
	}
}

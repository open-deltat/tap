{
	"name": "@tap/core",
	"version": "0.1.0",
	"description": "TAP v0.1 Core - Time Allocation Protocol foundation",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"example:server": "bun run examples/server.ts"
	},
	"dependencies": {
		"zod": "^3.23.8",
		"ulid": "^2.3.0"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}

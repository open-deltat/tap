{
  "name": "@open-deltat/client",
  "version": "0.2.1",
  "description": "TypeScript SDK for TAP, the Time Allocation Protocol: resources, rules, bookings, holds, availability, and recurrence, over deltat's PostgreSQL wire protocol.",
  "license": "MIT",
  "author": "Simon Orzel",
  "homepage": "https://delt.at",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-deltat/tap.git",
    "directory": "packages/client"
  },
  "keywords": ["scheduling", "availability", "booking", "calendar", "deltat"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test"
  },
  "dependencies": {
    "postgres": "^3.4.8",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}

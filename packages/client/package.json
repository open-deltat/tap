{
	"name": "@open-tap/client",
	"version": "0.2.0",
	"description": "TAP Client SDK - Browser and Node.js client for TAP availability and bookings",
	"keywords": [
		"tap",
		"time-allocation",
		"booking",
		"scheduling",
		"client",
		"sdk",
		"typescript"
	],
	"homepage": "https://github.com/open-tap/tap",
	"bugs": {
		"url": "https://github.com/open-tap/tap/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/open-tap/tap.git",
		"directory": "packages/client"
	},
	"license": "MIT",
	"author": "simonorzel26",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"dev": "tsc -p tsconfig.build.json --watch",
		"prepublishOnly": "bun run clean && bun run build",
		"test": "echo 'No tests yet'",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@open-tap/core": "workspace:*",
		"@open-tap/protocol": "workspace:*",
		"date-fns": "^3.6.0",
		"date-fns-tz": "^3.1.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}

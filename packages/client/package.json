{
	"name": "@tap/client",
	"version": "0.1.0",
	"description": "TAP Client SDK - Framework-agnostic client for TAP availability and bookings",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@tap/core": "workspace:*",
		"@tap/protocol": "workspace:*",
		"date-fns": "^3.6.0",
		"date-fns-tz": "^3.1.3"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}

{
	"name": "@open-tap/db",
	"version": "0.1.0",
	"private": true,
	"description": "TAP Federation PostgreSQL persistence layer (for central index)",
	"type": "module",
	"main": "./src/index.ts",
	"scripts": {
		"migrate": "bun run src/migrate.ts",
		"migrate:generate": "drizzle-kit generate",
		"migrate:push": "drizzle-kit push",
		"reset": "bun run src/reset.ts",
		"seed": "bun run src/seed.ts",
		"test": "echo 'No tests yet'",
		"test:watch": "bash ../../scripts/ensure-db.sh && bun test --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@open-tap/core": "workspace:*",
		"drizzle-orm": "^0.36.0",
		"postgres": "^3.4.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "^0.28.0"
	}
}
